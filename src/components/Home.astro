---
import '@fontsource-variable/instrument-sans';
import '@fontsource/instrument-serif/latin-400.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '../styles/global.css';
import Tour from './Tour.astro';
import { content, links, type Lang } from '../content';

interface Props {
  lang: Lang;
}

const t = content[Astro.props.lang];
const { labels } = t;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.name}</title>
    <meta name="description" content={t.description} />
    <link rel="canonical" href={Astro.url.href} />
    <link rel="alternate" hreflang={t.otherLanguage.hreflang} href={new URL(t.otherLanguage.href, Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <div class="page">
      <nav class="lang">
        <a href={t.otherLanguage.href} hreflang={t.otherLanguage.hreflang} lang={t.otherLanguage.hreflang}>{t.otherLanguage.label}</a>
      </nav>

      <header class="hero">
        <div>
          <h1>{t.name}</h1>
          <p class="hero__affiliation">{t.affiliation}</p>
          <ul class="hero__links">
            <li>
              <a href={`mailto:${links.email}`} aria-label={links.email} title={links.email}>
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                  <polyline points="22,6 12,13 2,6" />
                </svg>
              </a>
            </li>
            <li>
              <a href={links.github} aria-label={labels.github} title={labels.github}>
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />
                </svg>
              </a>
            </li>
            <li>
              <a href={links.cv} aria-label={labels.cv} title={labels.cv}>
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                  <polyline points="14 2 14 8 20 8" />
                  <line x1="16" y1="13" x2="8" y2="13" />
                  <line x1="16" y1="17" x2="8" y2="17" />
                </svg>
              </a>
            </li>
          </ul>
        </div>
        <div class="hero__figure"><Tour /></div>
      </header>

      <main>
        <section id="interests" class="section">
          <h2>{labels.interests}</h2>
          <ul class="interests">
            {t.interests.map((interest) => <li>{interest}</li>)}
          </ul>
        </section>

        <section id="publication" class="section">
          <h2>{labels.publication}</h2>
          <div>
            <h3 class="pub__title"><a href={links.paper}>{t.publication.title}</a></h3>
            <p class="muted">{t.publication.citation}</p>
            <p>{t.publication.method}</p>
            <p class="pub__links">
              <a href={links.paper}>{labels.paper}</a>
              <a href={links.code}>{labels.code}</a>
            </p>
          </div>
        </section>

        <section id="projects" class="section">
          <h2>{labels.projects}</h2>
          <div>
            <ul class="projects">
              {
                t.projects.map((project) => (
                  <li>
                    <a href={`${links.github}/${project.name}`}>{project.name}</a>
                    <p>{project.text}</p>
                  </li>
                ))
              }
            </ul>
            <p class="projects__all"><a href={links.repositories}>{labels.allRepositories}</a></p>
          </div>
        </section>

        <section id="experience" class="section">
          <h2>{labels.experience}</h2>
          <ul class="rows rows--dates">
            {
              t.experience.map((item) => (
                <li>
                  <span class="rows__key">{item.date}</span>
                  <span>{item.text}</span>
                </li>
              ))
            }
          </ul>
        </section>

        <section id="awards" class="section">
          <h2>{labels.awards}</h2>
          <ul class="rows rows--years">
            {
              t.awards.map((group) =>
                group.items.map((award, i) => (
                  <li>
                    <span class="rows__key">{i === 0 && group.year}</span>
                    <span>{award}</span>
                  </li>
                )),
              )
            }
          </ul>
        </section>
      </main>

      <footer class="footer">© {year} {t.name}</footer>
    </div>
  </body>
</html>
